{
  "data": {
    "input_path": "data/raw/food.parquet",
    "output_path": "data/processed/food_small.parquet",
    "max_rows": 500000
  },
  "model": {
    "output_path": "models/openfoodfacts_kmeans",
    "min_k": 2,
    "max_k": 8,
    "seed": 42,
    "max_iter": 50,
    "tolerance": 0.0001
  },
  "features": [
    "energy-kcal",
    "fat",
    "saturated-fat",
    "carbohydrates",
    "sugars",
    "fiber",
    "proteins",
    "salt"
  ]
}